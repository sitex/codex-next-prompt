#!/bin/sh

plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

case "$(uname -s)" in
Linux)
	os=linux
	;;
Darwin)
	os=darwin
	;;
*)
	printf '%s\n' "codex-next-prompt: unsupported operating system: $(uname -s)" >&2
	exit 0
	;;
esac

case "$(uname -m)" in
x86_64 | amd64)
	arch=amd64
	;;
arm64 | aarch64)
	arch=arm64
	;;
*)
	printf '%s\n' "codex-next-prompt: unsupported architecture: $(uname -m)" >&2
	exit 0
	;;
esac

exec "$plugin_root/bin/$os-$arch/codex-next-prompt" "$@"
